---
import { sanityClient, urlFor } from '../lib/sanity';

import { Image } from 'astro:assets';
import texture from '../assets/images/texture.gif';

import BaseLayout from '../layouts/BaseLayout.astro'; // <-- Importa o Layout

import Header from '../components/Header.astro';

import Drops from '../components/Drops.astro';

import Projects from '../components/Projects.astro';

const projetos = await sanityClient.fetch(
  `*[_type == "projeto"] | order(_modifiedAt desc)`,
);

const getStatusClass = (status: any) => {
  switch (status) {
    case 'rascunho':
      return 'bg-fuchsia-500/10 text-fuchsia-400 border-fuchsia-500/20';
    case 'concluido':
      return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
    case 'desenvolvimento':
      return 'bg-amber-500/10 text-amber-400 border-amber-500/20';
    case 'pausado':
      return 'bg-rose-500/10 text-rose-400 border-rose-800';
    default:
      return 'bg-zinc-800 text-zinc-400';
  }
};
---

<!-- Chame o Layout aqui abrindo e fechando a tag -->
<BaseLayout title="Atelier667 — Home">
  <Header isHome={true} />
  <!-- Grid de Projetos -->
  <Drops />
  <Projects />
</BaseLayout>
