---
import { sanityClient, urlFor } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro'; // <-- Importa o Layout

import Header from '../components/Header.astro';

const projetos = await sanityClient.fetch(
  `*[_type == "projeto"] | order(_createdAt desc)`,
);
const drops = await sanityClient.fetch(
  `*[_type == "drop"] | order(_createdAt desc)`,
);

const getStatusClass = (status: any) => {
  switch (status) {
    case 'concluido':
      return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
    case 'desenvolvimento':
      return 'bg-amber-500/10 text-amber-400 border-amber-500/20';
    case 'pausado':
      return 'bg-zinc-500/10 text-zinc-400 border-zinc-800';
    default:
      return 'bg-zinc-800 text-zinc-400';
  }
};
---

<!-- Chame o Layout aqui abrindo e fechando a tag -->
<BaseLayout title="Atelier667 — Home">
  <Header isHome={true} />
  <!-- Grid de Projetos -->
  <section
    id="drops-container"
    class="relative flex flex-col p-12 gap-4 border-r border-primary-800"
    data-drops={JSON.stringify(drops)}
  >
    <span
      class="font-serif text-2xl italic font-bold text-primary bg-primary-950 p-2 absolute -top-8 right-8 border-r-8 border-primary"
    >
      drops
    </span>

    <div id="drops-list" class="flex flex-col gap-4 *:opacity-100">
      {
        drops.slice(0, 2).map((drp: { content: string; timestamp: string }) => {
          const d = new Date(drp.timestamp);
          const dia = String(d.getDate()).padStart(2, '0');
          const mes = String(d.getMonth() + 1).padStart(2, '0');
          const ano = d.getFullYear();
          const hora = String(d.getHours()).padStart(2, '0');
          const min = String(d.getMinutes()).padStart(2, '0');
          const seg = String(d.getSeconds()).padStart(2, '0');
          const mil = String(d.getMilliseconds()).padStart(3, '0');

          const dropData = `${ano}.${mes}.${dia}`;
          const dropHora = `${hora}:${min}:${seg}.${mil}`;

          return (
            <article class="drop-card enter-drop relative  bg-primary-950/25 border-l-8 border-b border-primary-800 border-l-zinc-300 hover:border-l-primary transition flex flex-col justify-between font-sans font-light p-4 opacity-0">
              <p class="drop-content transition-all delay-300 duration-10000 h-auto">
                {drp.content}
              </p>
              <span class="inline-block absolute -bottom-2 -right-2 text-sm text-zinc-400 font-mono">
                <span class="drop-date">{dropData}</span>#
                <span class="drop-time text-xs">{dropHora}</span>
              </span>
            </article>
          );
        })
      }
    </div>

    <article
      class="relative bg-zinc-950/25 border-l-8 border-b border-zinc-800 transition flex flex-col justify-between font-sans font-light text-zinc-500 p-4"
    >
      <p>Mais Drops</p>
      <button
        id="next-drop"
        class="absolute right-4 top-1/2 -translate-y-1/2 text-6xl text-zinc-400 hover:text-white transition cursor-pointer"
      >
        +
      </button>
    </article>
  </section>

  <script>
    const container = document.getElementById('drops-container');
    const btnNext = document.getElementById('next-drop');
    const listContainer = document.getElementById('drops-list');

    // Parseamos a lista completa de drops que veio do Astro
    let localDrops = JSON.parse(container.getAttribute('data-drops') || '[]');

    function renderRotatedDrops() {
      const cards = listContainer.querySelectorAll('.drop-card');

      // Pegamos apenas os 2 primeiros do array rotacionado
      const activeDrops = localDrops.slice(0, 2);
      cards[0].classList.remove('slide-drop');
      void cards[0].offsetWidth;
      cards[0].classList.add('slide-drop');
      cards[1].classList.remove('enter-drop');
      void cards[1].offsetWidth;
      cards[1].classList.add('enter-drop');

      activeDrops.forEach((drp, index) => {
        if (!cards[index]) return;

        // Atualiza o texto do parágrafo
        cards[index].querySelector('.drop-content').textContent = drp.content;

        // Formata a nova data/hora no padrão da oficina
        const d = new Date(drp.timestamp);
        const dia = String(d.getDate()).padStart(2, '0');
        const mes = String(d.getMonth() + 1).padStart(2, '0');
        const ano = d.getFullYear();
        const hora = String(d.getHours()).padStart(2, '0');
        const min = String(d.getMinutes()).padStart(2, '0');
        const seg = String(d.getSeconds()).padStart(2, '0');
        const mil = String(d.getMilliseconds()).padStart(3, '0');

        cards[index].querySelector('.drop-date').textContent =
          `${ano}.${mes}.${dia}`;
        cards[index].querySelector('.drop-time').textContent =
          `${hora}:${min}:${seg}.${mil}`;
      });
    }

    btnNext.addEventListener('click', () => {
      if (localDrops.length <= 2) return; // Não faz sentido rotacionar se tiver 2 ou menos

      // ROTACIONA O ARRAY: Tira o primeiro elemento e empurra pro final
      const first = localDrops.shift();
      localDrops.push(first);

      // Renderiza as novas informações nos cards existentes
      renderRotatedDrops();
    });
  </script>
  <section
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 font-sans p-6"
  >
    {
      projetos.map(
        (proj: {
          mainImage: any;
          title_pt: unknown;
          categorias: unknown;
          status: string;
          progresso: unknown;
          slug: { current: any };
        }) => (
          <article class="group relative bg-zinc-800 border-t p-3 border-primary-800 overflow-hidden hover:border-primary-500 duration-700 transition flex flex-col aspect-square justify-between">
            <h2 class="text-2xl border-l-8 border-primary pl-2 mt-3 font-bold text-primary-200 group-hover:text-primary transition font-serif italic">
              {proj.title_pt}
            </h2>

            <span
              class={`px-2.5 py-0.5 w-fit  border ${getStatusClass(proj.status)} font-medium capitalize`}
            >
              {proj.status === 'concluido'
                ? 'Concluído'
                : proj.status === 'desenvolvimento'
                  ? 'Em Progresso'
                  : proj.status === 'ideacao'
                    ? 'Ideação'
                    : 'Pausado'}
            </span>
            {proj.progresso !== undefined && (
              <span
                class="text-zinc-200 font-mono absolute w-auto bottom-0 px-2 right-4 min-h-12 bg-zinc-950/50 border-r border-primary"
                style={`height:${proj.progresso}%;`}
              >
                {proj.progresso}%
              </span>
            )}

            <div class=" w-full  overflow-hidden  relative inline-flex">
              <a
                href={`/projeto/${proj.slug.current}`}
                class="aspect-square w-1/2 bg-zinc-950"
              >
                {proj.mainImage && (
                  <img
                    src={urlFor(proj.mainImage).width(600).url()}
                    alt={proj.title_pt}
                    class="h-full aspect-square object-cover opacity-50 group-hover:scale-103 group-hover:opacity-100 transition duration-300 font-serif"
                    loading="lazy"
                  />
                )}
              </a>
              {proj.categorias && (
                <span class="ml-2 uppercase tracking-wider font-light flex flex-col   ">
                  {proj.categorias.map((categoria: unknown) => (
                    <span class="text-xs bg-zinc-800 text-zinc-400 mx-2 my-1 py-1 border-t border-primary-500">
                      #{categoria}
                    </span>
                  ))}
                </span>
              )}
            </div>

            <a
              href={`/projeto/${proj.slug.current}`}
              class="w-auto -m-3 py-2 text-center block bg-primary-800 group-hover:bg-primary text-zinc-200 group-hover:text-zinc-900 transition duration-700 text-lg font-medium  "
            >
              Abrir Log Técnico →
            </a>
          </article>
        ),
      )
    }
  </section>
</BaseLayout>
