---
import '../styles/global.css';
import { sanityClient } from '../lib/sanity';

// O resto do código continua igual...
const projetos = await sanityClient.fetch(`*[_type == "projeto"]{
  title_pt,
  status,
  progresso,
  categoria,
  tags
}`);
---

<html lang="pt-br">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Atelier667 | Artesanato Técnico</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen p-8">
		<main class="max-w-4xl mx-auto">
			<header class="border-b border-zinc-800 pb-4 mb-8">
				<h1 class="text-3xl font-black tracking-wider text-orange-550">ATELIER667</h1>
				<p class="text-zinc-400 text-sm italic">"Artesanato Técnico" — Level UP (+1)</p>
			</header>

			<section>
				<h2 class="text-xl font-bold mb-4 text-zinc-300">Projetos na Bancada</h2>
				
				{projetos.length === 0 ? (
					<p class="text-zinc-500 italic text-sm">Nenhum projeto encontrado no banco de dados.</p>
				) : (
					<div class="grid gap-4 md:grid-cols-2">
						{projetos.map((proj) => (
							<div class="bg-zinc-900 border border-zinc-800 p-4 rounded-sm shadow-md">
								<div class="flex justify-between items-start mb-2">
									<h3 class="font-bold text-lg text-white">{proj.title_pt}</h3>
									<span class="text-xs uppercase bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded-sm">
										{proj.categoria}
									</span>
								</div>
								
								<div class="space-y-2">
									<div class="flex justify-between text-xs text-zinc-400">
										<span>Status: <strong class="text-orange-400">{proj.status}</strong></span>
										<span>{proj.progresso}%</span>
									</div>
									{/* Barra de progresso maker */}
									<div class="w-full bg-zinc-800 h-1.5 rounded-full overflow-hidden">
										<div class="bg-orange-500 h-full" style={`width: ${proj.progresso}%`}></div>
									</div>
								</div>

								{proj.tags && (
									<div class="flex flex-wrap gap-1.5 mt-4">
										{proj.tags.map((tag) => (
											<span class="text-[10px] bg-zinc-950 text-zinc-500 px-2 py-0.5 border border-zinc-800 rounded-sm">
												#{tag}
											</span>
										))}
									</div>
								)}
							</div>
						))}
					</div>
				)}
			</section>
		</main>
	</body>
</html>