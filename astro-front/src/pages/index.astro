---
import { sanityClient, urlFor } from '../lib/sanity';

import { Image } from 'astro:assets';
import texture from '../assets/images/texture.gif';

import BaseLayout from '../layouts/BaseLayout.astro'; // <-- Importa o Layout

import Header from '../components/Header.astro';

const projetos = await sanityClient.fetch(
  `*[_type == "projeto"] | order(_modifiedAt desc)`,
);
const drops = await sanityClient.fetch(
  `*[_type == "drop"] | order(_createdAt desc)`,
);

const getStatusClass = (status: any) => {
  switch (status) {
    case 'concluido':
      return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
    case 'desenvolvimento':
      return 'bg-amber-500/10 text-amber-400 border-amber-500/20';
    case 'pausado':
      return 'bg-zinc-500/10 text-zinc-400 border-zinc-800';
    default:
      return 'bg-zinc-800 text-zinc-400';
  }
};
---

<!-- Chame o Layout aqui abrindo e fechando a tag -->
<BaseLayout title="Atelier667 — Home">
  <Header isHome={true} />
  <!-- Grid de Projetos -->
  <section
    id="drops-container"
    class={`relative m-4 p-4 py-10 flex flex-col gap-4 border border-second/40 bg-zinc-950
  after:content-['']
  after:absolute
  after:block
  after:-inset-10
  after:p-20
  after:bg-third
  after:mask-[url(${texture.src})]
  after:-z-10`}
  >
    <span class="absolute -top-12 right-8 perspective-near">
      <span
        class="font-serif text-5xl italic font-black text-zinc-900 bg-second px-8 py-4 block -rotate-y-30 rotate-x-6"
        >drops</span
      >
    </span>

    <ul
      id="drops-list"
      class="relative transition-all duration-1000 flex flex-col h-full overflow-hidden [&>*:nth-child(n+3)]:max-h-0 [&>*:nth-child(n+3)]:py-0
      [&>*:nth-child(n+3)]:border-b-0 [&>*:nth-child(n+3)]:gap-0 [&>*:nth-child(n+3)]:overflow-hidden [&>*:nth-child(n+3)]:*:h-0"
    >
      {
        drops.map((drp: { content: string; timestamp: string }) => {
          const d = new Date(drp.timestamp);
          const dia = String(d.getDate()).padStart(2, '0');
          const mes = String(d.getMonth() + 1).padStart(2, '0');
          const ano = d.getFullYear();
          const hora = String(d.getHours()).padStart(2, '0');
          const min = String(d.getMinutes()).padStart(2, '0');
          const seg = String(d.getSeconds()).padStart(2, '0');
          const mil = String(d.getMilliseconds()).padStart(3, '0');

          const dropData = `${ano}.${mes}.${dia}`;
          const dropHora = `${hora}:${min}:${seg}.${mil}`;

          return (
            <li class="translate-y-0 duration-1000 bg-primary-950/25 border-l-8 border-b border-primary-800 border-l-zinc-300 hover:border-l-primary transition-all flex flex-col justify-between font-sans font-light  mb-0">
              {' '}
              <p class="h-auto">{drp.content}</p>
              <span class="inline-block absolute -bottom-2 -right-2 text-sm text-zinc-400 font-mono">
                <span class="drop-date">{dropData}</span>#
                <span class="drop-time text-xs">{dropHora}</span>
              </span>
            </li>
          );
        })
      }
    </ul>

    <article
      class="relative bg-zinc-950/25 border-l-8 border-b border-zinc-800 transition flex flex-col justify-between font-sans font-light text-zinc-500"
    >
      <p>Mais Drops</p>
      <button
        id="next-drop"
        class="absolute right-4 top-1/2 -translate-y-1/2 text-6xl text-zinc-400 hover:text-white transition cursor-pointer"
      >
        +
      </button>
    </article>
  </section>

  <script>
    const btnNext = document.getElementById('next-drop');
    if (btnNext) {
      btnNext.addEventListener('click', () => {
        const dropsContainer = document.getElementById('drops-container');
        const dropsLista = dropsContainer?.querySelector('ul');
        const dropsFirst = dropsLista?.querySelector('li') as HTMLElement; // Forçando tipagem rápida se for TS

        if (dropsLista && dropsFirst) {
          // Pega a altura exata do elemento para o margin negativo ser perfeito
          const CurrentHeight = dropsFirst.offsetHeight;

          // 1. Aplica a transição de subida e sumiço
          dropsFirst.style.transition = 'margin-top 1s linear, opacity 1s ease';
          dropsFirst.style.marginTop = `-${CurrentHeight}px`;
          dropsFirst.style.opacity = '0';

          // 2. Espera 1 segundo a animação acabar
          setTimeout(() => {
            // 3. Move para o final do DOM
            dropsLista.appendChild(dropsFirst);

            // 4. Reseta os estilos inline para ele voltar ao normal no fim da fila
            dropsFirst.style.transition = 'none';
            dropsFirst.style.marginTop = '0px';
            dropsFirst.style.opacity = '1';

            // Força o browser a registrar o reset antes de reativar transições do CSS do Tailwind
            setTimeout(() => {
              dropsFirst.style.transition = '';
            }, 50);
          }, 1000);
        }
      });
    }
  </script>
  <section
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-6 font-sans"
  >
    {
      projetos.map(
        (proj: {
          mainImage: any;
          title_pt: unknown;
          categorias: unknown;
          status: string;
          progresso: unknown;
          slug: { current: any };
        }) => (
          <article class="group relative bg-zinc-800 border-t p-y-3 border-primary-800 overflow-hidden hover:border-primary-500 duration-700 transition flex flex-col aspect-square justify-between">
            <h2 class="text-2xl border-l-8 border-primary pl-2 mt-3 font-bold text-primary-200 group-hover:text-primary transition font-serif italic">
              {proj.title_pt}
            </h2>

            <span
              class={`px-2.5 py-0.5 w-fit  border ${getStatusClass(proj.status)} font-medium capitalize`}
            >
              {proj.status === 'concluido'
                ? 'Concluído'
                : proj.status === 'desenvolvimento'
                  ? 'Em Progresso'
                  : proj.status === 'ideacao'
                    ? 'Ideação'
                    : 'Pausado'}
            </span>
            {proj.progresso !== undefined && (
              <span
                class="text-zinc-200 font-mono absolute w-auto bottom-0 px-2 right-4 min-h-12 bg-zinc-950/50 border-r border-primary"
                style={`height:${proj.progresso}%;`}
              >
                {proj.progresso}%
              </span>
            )}

            <div class=" w-full  overflow-hidden  relative inline-flex">
              <a
                href={`/projeto/${proj.slug.current}`}
                class="aspect-square w-1/2 bg-zinc-950"
              >
                {proj.mainImage && (
                  <img
                    src={urlFor(proj.mainImage).width(600).url()}
                    alt={proj.title_pt}
                    class="h-full aspect-square object-cover opacity-50 group-hover:scale-103 group-hover:opacity-100 transition duration-300 font-serif"
                    loading="lazy"
                  />
                )}
              </a>
              {proj.categorias && (
                <span class="ml-2 uppercase tracking-wider font-light flex flex-col   ">
                  {proj.categorias.map((categoria: unknown) => (
                    <span class="text-xs bg-zinc-800 text-zinc-400 mx-2 my-1 py-1 border-t border-primary-500">
                      #{categoria}
                    </span>
                  ))}
                </span>
              )}
            </div>

            <a
              href={`/projeto/${proj.slug.current}`}
              class="w-auto -m-3 py-2 text-center block bg-primary-800 group-hover:bg-primary text-zinc-200 group-hover:text-zinc-900 transition duration-700 text-lg font-medium  "
            >
              Abrir Log Técnico →
            </a>
          </article>
        ),
      )
    }
  </section>
</BaseLayout>
