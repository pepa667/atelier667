---
import { sanityClient, urlFor } from '../lib/sanity';

const drops = await sanityClient.fetch(
  `*[_type == "drop"] | order(_createdAt desc)`,
);
---

<section
  id="drops-container"
  class="relative m-4 p-4 py-10 flex flex-col gap-4 bg-zinc-950"
>
  <div class="absolute -inset-1 bg-second/40 -z-1 texture-to-[to_bottom]"></div>
  <span class="absolute -top-12 right-8 perspective-near">
    <span
      class="font-serif text-5xl italic font-black text-zinc-900 bg-second px-8 py-4 block -rotate-y-30 rotate-x-6"
      >drops</span
    >
  </span>

  <div
    id="drops-list"
    class="relative transition-all duration-1000 flex flex-col gap-14 h-full overflow-hidden *:flex [&>*:nth-child(n+3)]:hidden [&>*:nth-child(n+3)]:max-h-0 [&>*:nth-child(n+3)]:py-0
      [&>*:nth-child(n+3)]:border-b-0 [&>*:nth-child(n+3)]:gap-0 [&>*:nth-child(n+3)]:overflow-hidden [&>*:nth-child(n+3)]:*:h-0"
  >
    {
      drops.map(
        (drp: { title: string; content: string; timestamp: string }) => {
          const d = new Date(drp.timestamp);
          const dia = String(d.getDate()).padStart(2, '0');
          const mes = String(d.getMonth() + 1).padStart(2, '0');
          const ano = d.getFullYear();
          const hora = String(d.getHours()).padStart(2, '0');
          const min = String(d.getMinutes()).padStart(2, '0');
          const seg = String(d.getSeconds()).padStart(2, '0');
          const mil = String(d.getMilliseconds()).padStart(3, '0');

          const dropData = `${ano}.${mes}.${dia}`;
          const dropHora = `${hora}:${min}:${seg}.${mil}`;

          return (
            <article class=" flex flex-row justify-between font-sans font-light ">
              <div class="relative  flex flex-col font-title py-4 px-12 border text-center ">
                <span class="text-2xl font-title">{ano}</span>
                <span class="text-6xl">{dia}</span>
                <span class="text-4xl">.{mes}</span>
              </div>
              <div class="flex flex-row relative w-full h-auto text-4xl px-12 items-center border border-third ">
                {drp.title}
              </div>
              <div class="relative w-auto h-auto text-xl text-zinc-400 font-slab items-center border border-third before:content-['TIME'] block  content-center">
                {dropHora}
              </div>
              <button class="border px-12">#</button>
            </article>
          );
        },
      )
    }
  </div>

  <article class="flex flex-row justify-between font-sans font-light">
    <div
      class="relative flex flex-col font-title py-4 px-12 border text-center"
    >
      <span class="text-8xl font-title">+</span>
    </div>
    <div
      class="flex flex-row relative w-full h-auto text-4xl px-12 items-center border border-third"
    >
      Mais Drops
    </div>
    <button id="next-drop" class="border px-12">+</button>
  </article>
  <script>
    const btnNext = document.getElementById('next-drop');
    if (btnNext) {
      btnNext.addEventListener('click', () => {
        const dropsContainer = document.getElementById('drops-container');
        // getElementById is not available on HTMLElement, use querySelector scoped to the container
        const dropsLista = dropsContainer?.querySelector(
          '#drops-list',
        ) as HTMLElement | null;
        const dropsFirst = dropsLista?.querySelector(
          'article',
        ) as HTMLElement | null; // Forçando tipagem rápida se for TS

        if (dropsLista && dropsFirst) {
          // Pega a altura exata do elemento para o margin negativo ser perfeito
          const CurrentHeight = dropsFirst.offsetHeight;

          // 1. Aplica a transição de subida e sumiço
          dropsFirst.style.transition = 'margin-top 1s linear, opacity 1s ease';
          dropsFirst.style.marginTop = `-${CurrentHeight}px`;
          dropsFirst.style.opacity = '0';

          // 2. Espera 1 segundo a animação acabar
          setTimeout(() => {
            // 3. Move para o final do DOM
            dropsLista.appendChild(dropsFirst);

            // 4. Reseta os estilos inline para ele voltar ao normal no fim da fila
            dropsFirst.style.transition = 'none';
            dropsFirst.style.marginTop = '0px';
            dropsFirst.style.opacity = '1';

            // Força o browser a registrar o reset antes de reativar transições do CSS do Tailwind
            setTimeout(() => {
              dropsFirst.style.transition = '';
            }, 50);
          }, 1000);
        }
      });
    }
  </script>
</section>
