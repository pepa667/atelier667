---
import { Image } from "astro:assets";
import texture from "../assets/images/texture.gif";

import Icon from "../components/Icon.astro";

// Recebemos uma propriedade para saber se estamos na Home ou em uma página interna
---

<header class="pb-8 relative transition-all duration-300 mb-[10svh]">
  <div
    class="flex flex-col md:flex-row md:items-center md:justify-between gap-4"
  >
    <div>
      <div class="relative inline-block">
        <div
          class="absolute -right-10 -bottom-4 md:-right-20 md:-bottom-8 pop_01"
        >
          <Icon Icon="Maker" class="w-18 md:w-32" />
        </div>
        <h1
          class="relative font-title text-[clamp(4rem,12vw,10rem)] leading-none texture text-primary my-2 lg:my-4"
        >
          <span
            class="min-w-4 max-w-20 w-[5svw] h-[clamp(0.5em,10vw,8rem)] bg-primary inline-block relative"
          ></span>
          Atelier667
        </h1>
      </div>
      <p
        class="text-zinc-300 font-light text-xs md:text-lg lg:text-xl font-sans"
      >
        Oficina Maker<span class="text-primary px-1">&bullet;</span>Traço,
        Código e Matéria
      </p>
    </div>

    <nav class="flex items-center gap-6 font-serif-2 text-sm tracking-wider">
      <a
        href="/"
        class="text-zinc-400 hover:text-white transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 hover:after:w-full after:bg-primary after:transition-all"
      >
        Projetos
      </a>
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-500 hover:text-white transition-colors flex items-center gap-1"
      >
        GitHub <span>↗</span>
      </a>
    </nav>
  </div>
</header>
