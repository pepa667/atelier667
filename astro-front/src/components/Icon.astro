---
import { Image } from "astro:assets";

import Maker from "../assets/images/icons/maker.png";
import Deco from "../assets/images/icons/deco.png";
import Code from "../assets/images/icons/code.png";
import Hardware from "../assets/images/icons/hardware.png";
import Machine from "../assets/images/icons/machine.png";
import Punk from "../assets/images/icons/punk.png";
import WoodWorking from "../assets/images/icons/woodworking.png";

// Agora o "Size" é opcional! Se não for passado, você controla o tamanho 100% pelas classes do Tailwind
const { Icon = "Deco", Size, class: className } = Astro.props;

const iconMap = {
  Maker,
  Deco,
  Code,
  Hardware,
  Machine,
  Punk,
  WoodWorking,
};

const activeIcon = iconMap[Icon] || Deco;

// Define as dimensões do sprite (X colunas por Y linhas)

const spriteSizes = {
  Code: { x: 4, y: 1 },
  Deco: { x: 4, y: 6 },
  Hardware: { x: 3, y: 2 },
  Machine: { x: 3, y: 2 },
  Maker: { x: 5, y: 2 },
  Punk: { x: 3, y: 2 },
  WoodWorking: { x: 4, y: 2 },
};

// Puxa as dimensões ou usa o padrão do 'Deco' como fallback
const { x: max_X, y: max_Y } = spriteSizes[Icon] || spriteSizes.Deco;
// Se o usuário passou um "Size" fixo, usamos ele. Se não, deixamos livre para o Tailwind agir.
const containerStyle = Size ? `width: ${Size}px; height: ${Size}px;` : "";
---

<div
  class:list={["relative overflow-hidden aspect-square", className]}
  style={containerStyle}
>
  <Image
    src={activeIcon}
    class="absolute max-w-none sprite-target"
    style={`width: ${max_X * 100}%; height: ${max_Y * 100}%; top: 0px; left: 0px;`}
    data-max-x={max_X}
    data-max-y={max_Y}
    alt={`Ícone de ${Icon}`}
  />
</div>
<script>
  function randomizeSprites() {
    const targets = document.querySelectorAll(".sprite-target");

    targets.forEach((el) => {
      if (el instanceof HTMLElement) {
        const maxX = parseInt(el.dataset.maxX || "4", 10);
        const maxY = parseInt(el.dataset.maxY || "6", 10);

        // Sorteia o frame (0 até max - 1)
        const frameX = Math.floor(Math.random() * maxX);
        const frameY = Math.floor(Math.random() * maxY);

        // A mágica da porcentagem: calcula o offset baseado no número total de intervalos
        // Se maxX é 4, os frames são 0, 1, 2, 3. Os deslocamentos em % serão: 0%, 33.33%, 66.66%, 100%.
        const percentX = frameX * 100;
        const percentY = frameY * 100;

        // O CSS traduz "left: -50%" de forma relativa ao tamanho do container pai automaticamente!
        el.style.left = `-${percentX}%`;
        el.style.top = `-${percentY}%`;
      }
    });
  }

  randomizeSprites();
  document.addEventListener("astro:after-swap", randomizeSprites);
</script>
