---
import type { string } from 'astro:schema';
import { sanityClient, urlFor } from '../lib/sanity';

const projetos = await sanityClient.fetch(
  `*[_type == "projeto"] | order(_modifiedAt desc)`,
);

const getStatusClass = (status: any) => {
  switch (status) {
    case 'rascunho':
      return 'bg-fuchsia-500/10 text-fuchsia-400 border-fuchsia-500/20';
    case 'concluido':
      return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
    case 'desenvolvimento':
      return 'bg-amber-500/10 text-amber-400 border-amber-500/20';
    case 'pausado':
      return 'bg-rose-500/10 text-rose-400 border-rose-800';
    default:
      return 'bg-zinc-800 text-zinc-400';
  }
};

// Exemplo de como componentizar isso no Astro
const { value = 50, totalLength = 10 } = Astro.props;

const filledCount = Math.round((value / 100) * totalLength);
const emptyCount = totalLength - filledCount;

const progressBar = `[${'█'.repeat(filledCount)}${'░'.repeat(emptyCount)}]`;
---

<section
  class="mt-[20svh] grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8 gap-y-16 font-sans bg-zinc-950/90
  relative p-8 py-32"
>
  <div
    class="absolute -inset-0.5 bg-primary/40 -z-1 texture_md perspective-near"
  >
  </div>
  <div
    class="absolute size-0 -top-20 right-5 md:-right-20 border-l-[30svw] border-r-[5svw] border-x-transparent mask-[110%,50%] rotate-y-16 -rotate-x-24 border-t-300 rounded-xl border-primary texture_md-to-[to_bottom]"
  >
  </div>

  <div class="absolute -top-15 left-[5%]">
    <div
      class="font-serif text-6xl italic font-black text-primary texture mask-size-[200%]"
    >
      Projetos::
    </div>
  </div>
  {
    projetos.map(
      (proj: {
        mainImage: any;
        title_pt: string;
        categorias: string[]; // Tipado corretamente como array de strings
        status: string;
        progresso: number; // Trocado de unknown para number para a matemática da barra funcionar
        slug: { current: any };
      }) => {
        // --- CONFIGURAÇÃO DA BARRA ASCII DINÂMICA ---
        const tamanhoTotalBarra = 10; // Define o tamanho visual da barra (ex: 10 caracteres)
        const porcentagem = proj.progresso || 0;

        // Calcula quantos blocos cheios e vazios desenhar (limita entre 0 e o tamanho total)
        const blocosCheios = Math.max(
          0,
          Math.min(
            tamanhoTotalBarra,
            Math.round((porcentagem / 100) * tamanhoTotalBarra),
          ),
        );
        const blocosVazios = Math.max(0, tamanhoTotalBarra - blocosCheios);

        // Monta a string da barra: [█████░░░░░]
        const barraAscii = `[${'█'.repeat(blocosCheios)}${'░'.repeat(blocosVazios)}]`;

        return (
          <article class="group relative  isolate  ">
            <div class="absolute inset-x-0 -inset-y-3 block bg-primary texture -z-1" />
            <div class="bg-zinc-950/95 m-y-12    flex flex-col justify-between  h-full ">
              <a href={`/projeto/${proj.slug.current}`}>
                <h2 class="text-5xl sm:text-3xl lg:text-4xl border-l-8 border-second pl-2 mt-3 font-bold text-zinc-200 group-hover:text-second transition font-title">
                  {proj.title_pt}
                </h2>
              </a>
              <span
                class={`px-2.5 py-0.5 w-fit my-4 ml-4 border-4 ${getStatusClass(proj.status)} font-medium capitalize`}
              >
                {proj.status === 'concluido'
                  ? 'Concluído'
                  : proj.status === 'desenvolvimento'
                    ? 'Em Progresso'
                    : proj.status === 'rascunho'
                      ? 'Rascunho'
                      : 'Pausado'}
              </span>
              <code class="font-mono text-second text-lg md:text-xl lg:text-lg xl:text-2xl px-0 py-1 inline-block whitespace-nowrap">
                {barraAscii} {porcentagem}%{''}
              </code>
              <div class="ml-2 w-11/12 overflow-hidden self-baseline py-4 mask-marquee">
                {proj.categorias && proj.categorias.length > 0 ? (
                  /* O container flex agora ganha a animação 'animate-marquee' */
                  <ul class="flex flex-row whitespace-nowrap list-none animate-marquee w-max uppercase tracking-wider font-light">
                    {/* BLOCO 1: Renderiza original */}
                    {proj.categorias.map((categoria: string) => (
                      <li class="text-xs bg-second/10 text-second mx-2 my-1 py-2 px-3 border rounded border-second inline-block">
                        #{categoria || 'Nada'}
                      </li>
                    ))}

                    {/* BLOCO 2: Duplicado idêntico para criar o efeito infinito visual */}
                    {proj.categorias.map((categoria: string) => (
                      <li
                        class="text-xs bg-second/10 text-second mx-2 my-1 py-2 px-3 border rounded border-second inline-block"
                        aria-hidden="true"
                      >
                        #{categoria || 'Nada'}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <ul class="list-none">
                    <li class="text-xs bg-second/10 text-second mx-2 my-1 py-2 px-3 border rounded border-second inline-block">
                      Não tem
                    </li>
                  </ul>
                )}
              </div>
              <div class=" w-full  overflow-hidden  relative inline-flex">
                <a
                  href={`/projeto/${proj.slug.current}`}
                  class="aspect-2/1 w-full bg-zinc-950"
                >
                  {proj.mainImage && (
                    <img
                      src={urlFor(proj.mainImage).width(300).url()}
                      alt={proj.title_pt}
                      class="w-full aspect-2/1 object-cover opacity-50 group-hover:scale-103 group-hover:opacity-100 transition duration-300 font-serif"
                      loading="lazy"
                    />
                  )}
                </a>
              </div>
              <a
                href={`/projeto/${proj.slug.current}`}
                class="w-auto  text-center block bg-primary/10 group-hover:bg-second text-zinc-200 group-hover:text-zinc-950 transition duration-700 text-lg font-medium  py-2 border-b-12 border-zinc-950"
              >
                Abrir Log Técnico →
              </a>
            </div>
          </article>
        );
      },
    )
  }
</section>
