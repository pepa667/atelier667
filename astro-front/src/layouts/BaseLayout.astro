---
import Icon from '../components/Icon.astro';

// Puxa o CSS global uma vez só aqui!
import '../styles/global.css';


import SideScroller from '../components/SideScroller.astro';
// Recebe o título dinâmico da página como propriedade
const { title = 'Atelier667 — Projetos Maker' } = Astro.props;
---

<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script is:inline>
      (function () {
        const originalHues = [74, 330, 186, 43];
        const filterMap = {
          74: 'brightness(0) saturate(100%) invert(86%) sepia(97%) saturate(447%) hue-rotate(22deg) brightness(105%) contrast(121%)',
          330: 'brightness(0) saturate(100%) invert(16%) sepia(81%) saturate(5968%) hue-rotate(322deg) brightness(99%) contrast(110%)',
          186: 'brightness(0) saturate(100%) invert(73%) sepia(50%) saturate(3689%) hue-rotate(143deg) brightness(102%) contrast(112%)',
          43: 'brightness(0) saturate(100%) invert(72%) sepia(87%) saturate(527%) hue-rotate(340deg) brightness(105%) contrast(97%)',
        };

        const shuffledHues = [...originalHues].sort(() => Math.random() - 0.5);
        const root = document.documentElement;

        shuffledHues.forEach((hue, index) => {
          root.style.setProperty(`--hue-rotate-${index + 1}`, hue);
          const filterValue = filterMap[hue];
          if (filterValue) {
            root.style.setProperty(`--img-hue-${index + 1}`, filterValue);
          }
        });
      })();
    </script>
  </head>
</html>
<body class="bg-zinc-950 text-zinc-200 min-h-screen relative">
  <div
    class="absolute inset-0 w-full h-full bg-fourth/5 texture_md-to-[to_bottom]"
  >
  </div>
  <Icon Icon="Maker" class="hidden" />
  <div
    class="mx-auto w-svw md:w-[95svw] max-w-[95svw] relative flex flex-row justify-around overflow-clip"
  >
    <SideScroller />
    <!-- O <slot /> injeta o HTML específico de cada página aqui dentro -->
    <div class="flex flex-col m-4 w-full lg:m-10 lg:w-[90svw] 2xl:w-[70svw]">
      <slot />
    </div>
  </div>
  <!-- src/layouts/BaseLayout.astro -->

  <!-- No final do arquivo, ou onde preferir -->
  <script>
    function applyTexturePosition() {
      const textured = document.querySelectorAll(
        '.texture, [class*="texture-to-"],.texture_md, [class*="texture_md-to-"]',
      );

      textured.forEach((el) => {
        // CORREÇÃO: Type Guard para acalmar o TypeScript
        if (el instanceof HTMLElement) {
          const posX = Math.random() * 100;
          const posY = Math.random() * 100;
          const posValue = `${posX}% ${posY}%`;

          el.style.setProperty('--mask-pos', posValue);
          el.style.maskPosition = posValue;
          el.style.webkitMaskPosition = posValue;
        }
      });
    }

    // Executa
    applyTexturePosition();

    // Se usar View Transitions do Astro, descomente:
    // document.addEventListener('astro:after-swap', applyTexturePosition);
  </script></body
>
