---
// 1. Importa o componente nativo de imagem do Astro
import { Image } from 'astro:assets';

// 2. Importa a imagem local direto do seu diretório de assets
import atelierBanner from '../assets/images/atelier.png';
// (Ajuste os pontinhos `../` dependendo de quão profunda está a pasta do arquivo atual)

// Puxa o CSS global uma vez só aqui!
import '../styles/global.css';

// Recebe o título dinâmico da página como propriedade
const { title = 'Atelier667 — Projetos Maker' } = Astro.props;
---

<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-zinc-950 text-zinc-200 min-h-screen">
    <div
      class="mx-auto relative flex flex-row justify-center overflow-y-hidden"
    >
      <aside
        class="fixed h-svh top-0 left-0 xl:left-[calc(50svw-36rem-80px)] p-2"
      >
        <ol
          class="scroll-side-bar text-2xl *:inline-block *:text-primary whitespace-nowrap list-none p-0 *:before:content-['//'] *:before:text-white sm:text-4xl lg:text-4xl 2xl:text-6xl font-serif tracking-wider [writing-mode:vertical-lr] rotate-180 self-baseline border-l border-primary-800"
        >
          <li>Software</li>
          <li>Hardware</li>
          <li>Impressão</li>
          <li>CNC</li>
          <li>Retro Mod</li>
          <li>Firmware</li>
          <li>Arcade</li>
          <li>Marcenaria</li>
          <li>DevOps</li>
          <li>Ilustração</li>
          <li>Modelagem</li>
        </ol>
      </aside>
      <div class="w-6xl max-w-svw mt-8 inline-flex">
        <!-- O <slot /> injeta o HTML específico de cada página aqui dentro -->
        <span
          class="text-2xl sm:text-3xl lg:text-4xl 2xl:text-6xl font-serif tracking-wider [writing-mode:vertical-lr] rotate-180 self-baseline border-l border-primary-50 p-2 opacity-0 xl:hidden"
          >Pepa667</span
        >
        <div class="flex flex-col">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
