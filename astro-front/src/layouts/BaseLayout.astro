---
// 1. Importa o componente nativo de imagem do Astro
import { Image } from 'astro:assets';

// 2. Importa a imagem local direto do seu diretório de assets
import atelierBanner from '../assets/images/atelier.png';
// (Ajuste os pontinhos `../` dependendo de quão profunda está a pasta do arquivo atual)

// Puxa o CSS global uma vez só aqui!
import '../styles/global.css';

import SideScroller from '../components/SideScroller.astro';

// Recebe o título dinâmico da página como propriedade
const { title = 'Atelier667 — Projetos Maker' } = Astro.props;
---

<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script is:inline>
      (function () {
        // Os 4 valores de Hue (graus no círculo cromático) das suas cores originais
        const originalHues = [74, 330, 186, 43];

        // Embaralha os ângulos de matiz
        const shuffledHues = [...originalHues].sort(() => Math.random() - 0.5);

        // Aplica apenas os números nas variáveis do :root (HTML)
        const root = document.documentElement;
        root.style.setProperty('--hue-rotate-1', shuffledHues[0]);
        root.style.setProperty('--hue-rotate-2', shuffledHues[1]);
        root.style.setProperty('--hue-rotate-3', shuffledHues[2]);
        root.style.setProperty('--hue-rotate-4', shuffledHues[3]);

        // O loop correto vai de 0 até 3 (i < 4 ou i <= 3)
        for (let i = 0; i <= 3; i++) {
          // Se o valor for 74, você precisa mudar ou pular para não travar o navegador
          if (shuffledHues[i] === 74) {
            // Exemplo: muda para outro número ou use 'continue' para pular
            // O valor da string NÃO deve conter "filter:" nem ";"
            const filterValue =
              'brightness(0) saturate(100%) invert(86%) sepia(97%) saturate(447%) hue-rotate(22deg) brightness(105%) contrast(121%)';

            // Interpolação correta usando Template Literals (crases)
            root.style.setProperty(`--img-hue-${i + 1}`, filterValue);
          } else if (shuffledHues[i] === 330) {
            // Exemplo: muda para outro número ou use 'continue' para pular
            // O valor da string NÃO deve conter "filter:" nem ";"
            const filterValue =
              'brightness(0) saturate(100%) invert(16%) sepia(81%) saturate(5968%) hue-rotate(322deg) brightness(99%) contrast(110%)';

            // Interpolação correta usando Template Literals (crases)
            root.style.setProperty(`--img-hue-${i + 1}`, filterValue);
          } else if (shuffledHues[i] === 186) {
            // Exemplo: muda para outro número ou use 'continue' para pular
            // O valor da string NÃO deve conter "filter:" nem ";"
            const filterValue =
              'brightness(0) saturate(100%) invert(73%) sepia(50%) saturate(3689%) hue-rotate(143deg) brightness(102%) contrast(112%)';

            // Interpolação correta usando Template Literals (crases)
            root.style.setProperty(`--img-hue-${i + 1}`, filterValue);
          } else if (shuffledHues[i] === 43) {
            // Exemplo: muda para outro número ou use 'continue' para pular
            // O valor da string NÃO deve conter "filter:" nem ";"
            const filterValue =
              'brightness(0) saturate(100%) invert(72%) sepia(87%) saturate(527%) hue-rotate(340deg) brightness(105%) contrast(97%)';

            // Interpolação correta usando Template Literals (crases)
            root.style.setProperty(`--img-hue-${i + 1}`, filterValue);
          }
        }
      })();
    </script>
  </head>
</html>
<body class="bg-zinc-950 text-zinc-200 min-h-screen">
  <div class="mx-auto relative flex flex-row justify-center overflow-y-hidden">
    <SideScroller />
    <div class="w-6xl max-w-svw mt-8 inline-flex">
      <!-- O <slot /> injeta o HTML específico de cada página aqui dentro -->
      <span
        class="text-2xl sm:text-3xl py-4 lg:text-4xl 2xl:text-6xl font-serif tracking-wider [writing-mode:vertical-lr] rotate-180 self-baseline border-l border-primary-50 p-2 opacity-0 xl:hidden"
        >Pepa667</span
      >
      <div class="flex flex-col">
        <slot />
      </div>
    </div>
  </div>
</body>
